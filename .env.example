# Public HTTPS URL of this service. Required for Telegram Mini App and webhooks.
APP_PUBLIC_URL=https://your-domain.example
# Use this when the app lives under an existing domain path, for example:
# APP_PUBLIC_URL=https://poznaysebya.site/ascendlab
# APP_CONTEXT_PATH=/ascendlab
APP_CONTEXT_PATH=

# Telegram bot created with @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_BOT_USERNAME=AscendLabRobot
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_string

# Optional. If set, app will try to register the Telegram webhook on startup.
TELEGRAM_REGISTER_WEBHOOK=false
# Use this instead of webhook mode when the bot should read updates itself.
TELEGRAM_LONG_POLLING=false

# Kie.ai Gemini 2.5 Flash.
KIE_API_KEY=kie_replace_me
KIE_API_URL=https://api.kie.ai/gemini-2.5-flash/v1/chat/completions

# Crypto Bot / Crypto Pay. Use @CryptoTestnetBot and testnet URL for tests.
CRYPTO_PAY_TOKEN=replace_me
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot
CRYPTO_PAY_WEBHOOK_SECRET=replace_with_long_random_string

# YooKassa card payments. Configure webhook URL:
# https://your-domain.example/api/payments/yookassa/webhook/<YOOKASSA_WEBHOOK_SECRET>
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_WEBHOOK_SECRET=replace_with_long_random_string

# Local dev convenience.
APP_DEMO_MODE=true
PORT=8080
